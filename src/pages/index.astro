---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import Kennzahlen from "../components/Kennzahlen.astro";
import LogoMarquee from "../components/LogoMarquee.astro";

const services = await getCollection("services");

const cardOrder = [
  "corporate-influencer-programme",
  "linkedin-account-management",
  "cxo-communication",
  "keynotes",
  "schulungen",
];
const cards = cardOrder.map((slug) => services.find((s) => s.data.slug === slug)!);

const colorMap: Record<string, string> = {
  orange: "var(--color-orange)",
  blau: "var(--color-blue)",
  violett: "var(--color-violet)",
  schwarz: "var(--color-bg-dark)",
};

// Homepage-Card-Copy weicht bewusst von heroSubline der Unterseite ab, Text aus 2026_07_21_Di-CoCo_Webdesign.pdf.
// "lead" steht im Design fett in eigener Zeile über dem Fließtext.
const homepageCardCopy: Record<string, { lead: string; text: string }> = {
  "corporate-influencer-programme": {
    lead: "Deine Mitarbeitenden sind dein stärkster Kanal. Du nutzt ihn noch nicht.",
    text:
      "Ein CI-Programm ist kein Social-Media-Projekt. Es ist ein strategischer Eingriff in die Art, wie dein Unternehmen kommuniziert und wie es intern funktioniert. Wir entwickeln Programme, die Mitarbeitende zu sichtbaren Stimmen machen, Silos aufbrechen und echten Kulturwandel bringen.",
  },
  "linkedin-account-management": {
    lead: "Sichtbarkeit entsteht nicht durch Zufallsposts. Sondern durch Strategie.",
    text:
      "Di-CoCo übernimmt das vollständige strategische Management von LinkedIn-Accounts. Für Führungspersönlichkeiten und Unternehmen, die sichtbar sein wollen, ohne sich täglich damit zu beschäftigen.",
  },
  "cxo-communication": {
    lead: "Führungskräfte, die kommunizieren, führen anders.",
    text:
      "Wer als Führungspersönlichkeit sichtbar ist, schafft Vertrauen im Markt, Orientierung im Team und Relevanz in der Branche. Di-CoCo entwickelt Positionierung, Messaging und Content, damit deine Stimme nach dir klingt und Wirkung erzeugt.",
  },
  "keynotes": {
    lead: "Themen, die Entscheider bewegen. Vorträge, die nachhalten.",
    text:
      "Bianca Schiffgens spricht auf Konferenzen und Events zu Sichtbarkeit als Führungsaufgabe, Corporate Influencer Programmen und LinkedIn-Strategie. Kein Theorie-Vortrag. Echte Fälle, klare Haltung, konkrete Empfehlungen.",
  },
  "schulungen": {
    lead: "Das Programm läuft. Jetzt muss dein Team es tragen können.",
    text:
      "Di-CoCo schult Kommunikationsverantwortliche, HR-Teams und interne Programm-Manager, damit sie Corporate Influencer Programme eigenständig begleiten und weiterentwickeln können.",
  },
};

const referenzen = [
  {
    zitat: "Das Corporate Influencer Programm hat unsere Markenbekanntheit deutlich gesteigert. Die professionelle Begleitung hat nicht nur unsere Online-Präsenz optimiert, sondern auch intern eine neue Dynamik geschaffen.",
    name: "W. Weigel",
    rolle: "Geschäftsführer, Filoform GmbH · Glasfaser & Infrastruktur",
  },
  {
    zitat: "Wer behauptet, LinkedIn sei langweilig, hat offensichtlich noch nie mit Bianca Schiffgens gearbeitet. Sie ist die personifizierte Antwort auf die Frage: ‚Wie geht digitale Sichtbarkeit, aber bitte mit Charakter?‘",
    name: "Dr. C. Herbst",
    rolle: "Geschäftsführerin · Sona Strategy GmbH",
  },
  {
    zitat: "Bianca hat es geschafft, meine Werte und Ziele authentisch zu transportieren und eine nachhaltige Verbindung zu meiner Zielgruppe aufzubauen. Von der Skeptikerin zur überzeugten LinkedIn-Nutzerin.",
    name: "H. Henkel",
    rolle: "Olympiasiegerin, Keynote-Speakerin & Autorin",
  },
  {
    zitat: "Ich hatte das große Vergnügen, Bianca als Speakerin für unser Event zu gewinnen. Mit ihrer Expertise und ihrem verständlichen Vortragsstil wurde der Abend für alle Teilnehmenden zum echten Highlight. Ihre Professionalität, Verlässlichkeit und ihre inspirierende Art haben den Abend rundum gelungen gemacht. Klare Empfehlung von meiner Seite!",
    name: "F. Ringler",
    rolle: "Mentor Me · Passion für Tech & AI",
  },
  {
    zitat: "Biancas lockere und mitreißende Art gibt dem sehr professionellen Rahmen die besondere Note. Eines unserer Highlights im letzten Jahr.",
    name: "J. Mina-Knopp",
    rolle: "Geschäftsführerin, Mariposa GmbH",
  },
  {
    zitat: "Mit ihrem scharfen Blick für das Wesentliche, einer guten Portion Ironie und dem untrüglichen Gespür für das, was auf LinkedIn wirklich wirkt, bringt Bianca nicht nur Wissen, sondern auch jede Menge Energie und Humor ins Spiel. Authentisch. Klar. Und manchmal angenehm unbequem, denn Sichtbarkeit beginnt bekanntlich außerhalb der Komfortzone.",
    name: "Dr. C. Herbst",
    rolle: "Geschäftsführerin · Sona Strategy GmbH",
  },
  {
    zitat: "Bianca übernimmt mit ihrer Kommunikationsagentur eine führende Rolle in der Branche und ist als LinkedIn-Influencerin eine tägliche Inspiration für wertvollen Content. Ihre Leidenschaft fürs Netzwerken und ihre Hingabe, anderen zum Erfolg zu verhelfen, sind bewundernswert. Sie ist zweifellos eine Expertin auf ihrem Gebiet, und ich kann sie allen empfehlen, die ihre LinkedIn-Präsenz ernsthaft ausbauen möchten.",
    name: "K. Lages-Willner",
    rolle: "Vice President BPW Germany · LinkedIn Top Voice",
  },
];

const branchen = ["Industrie", "Technologie", "Beratung", "Finanzdienstleistung", "Energie", "Spitzensport", "E-Commerce", "Bildung", "Versicherung", "Banken", "Automotive"];

// Beschriftung bewusst immer zweizeilig, damit alle Einträge gleich hoch sind
const credentials = [
  { img: "/assets/badges/certified-linkedin-insider.webp", w: 459, h: 359, zeilen: ["Certified LinkedIn", "Marketing Insider"] },
  { img: "/assets/press/favikon-top10.svg", w: 512, h: 512, zeilen: ["Favikon Top 10 Communications", "Experts Germany"] },
  { img: "/assets/badges/buch-fuehrung-im-wandel.webp", w: 262, h: 367, zeilen: ["Autorin Springer", "Gabler Verlag"] },
  { img: "/assets/badges/icon-linkedin.webp", w: 340, h: 346, zeilen: ["25.000+", "LinkedIn-Follower"] },
];
---

<Layout
  title="Di-CoCo – Corporate Influencer Programme und LinkedIn-Strategie für Führungskräfte"
  description="Di-CoCo entwickelt Corporate Influencer Programme und LinkedIn-Strategien für Führungskräfte im deutschsprachigen Raum. Strategisch. Messbar. Mit echtem Kulturwandel."
>
  <section class="hero">
    <img class="hero__ribbon" src="/assets/decor/hero-ribbon.svg" alt="" width="544" height="556" aria-hidden="true" />
    <div class="hero__inner">
      <div class="hero__content">
        <p class="hero__eyebrow">Corporate Visibility Strategist</p>
        <h1><span class="hero__white">Sichtbar werden.</span><br /><span class="hero__orange">Etwas bewegen.</span></h1>
        <p class="hero__subline">
          Di-CoCo begleitet Führungspersönlichkeiten <br class="hero__subline-break" />und Unternehmen im deutschsprachigen Raum, <br class="hero__subline-break" />die wissen, dass Kommunikation mehr kann <br class="hero__subline-break" />als Reichweite zu erzeugen. <span class="hero__orange">Mit der richtigen <br class="hero__subline-break" />Strategie verändert Sichtbarkeit nicht nur, wie <br class="hero__subline-break" />ein Unternehmen wahrgenommen wird. Sie <br class="hero__subline-break" />verändert, wie es sich selbst versteht.</span>
        </p>
      </div>
    </div>
    <img class="hero__badge" src="/assets/badges/favikon-top10-white.svg" alt="" width="512" height="512" aria-hidden="true" />
    <a href="#claim" class="hero__scroll" aria-label="Nach unten scrollen">
      <svg width="16" height="9" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section class="claim" id="claim">
    <p class="claim__text gradient-text gradient-text--script">Visibility drives<br />business.</p>
    <div class="claim__actions">
      <a href="#kontakt" class="button">Lass uns sprechen</a>
      <a href="#leistungen" class="button button--outline">Was wir tun</a>
    </div>
  </section>

  <section class="bekannt-aus">
    <p class="bekannt-aus__label">Bekannt aus</p>
    <LogoMarquee />
  </section>

  <section class="ergebnisse">
    <p class="ergebnisse__label">Was wir mit und für unsere Kunden erreichen</p>
    <Kennzahlen />
  </section>

  <section class="wirkung">
    <div class="wirkung__inner">
      <p class="wirkung__eyebrow">Was wirklich passiert, wenn Kommunikation funktioniert</p>
      <h2>Die meisten Unternehmen unterschätzen, was Sichtbarkeit auslösen kann.</h2>
      <div class="wirkung__grid">
        <div class="wirkung__col">
          <div class="wirkung__divider"></div>
          <p>
            Nicht weil sie es nicht wissen wollen, sondern weil Kommunikation in vielen
            Organisationen noch immer als Aufgabe einer Abteilung gilt und nicht{" "}
            <span class="hl">als strategisches Instrument, das auf Führungsebene angesiedelt
            sein muss.</span>
          </p>
          <div class="wirkung__label-wrap">
            <p class="wirkung__label gradient-text--script">Der<br /><span class="gradient-text">interne</span><br />Effekt</p>
          </div>
        </div>
        <div class="wirkung__col">
          <div class="wirkung__divider"></div>
          <p>
            Das sehen wir seit 20 Jahren: Einem Menschen hört man eher zu als einem Logo.{" "}
            <span class="hl">Wenn Führungskräfte und Mitarbeitende eine echte Stimme
            entwickeln, verändert sich mehr als die Außenwirkung.</span>{" "}
            Es entsteht Vertrauen im Markt, im Netzwerk und in der Organisation selbst.
          </p>
          <p>
            Und hier passiert etwas, das wir immer wieder erleben und das unsere Kunden
            regelmäßig überrascht:{" "}
            <span class="hl">Wenn ein Corporate Influencer Programm gut angelegt ist, bricht
            es Silos auf.</span>{" "}
            Menschen aus verschiedenen Abteilungen lernen voneinander. Interne Netzwerke
            entstehen neu. Mitarbeitende fühlen sich gesehen, weil ihre Expertise plötzlich
            nach außen zählt.{" "}
            <span class="hl">Was als Kommunikationsprojekt beginnt, wird zu echtem
            Kulturwandel.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-band quote-band--bildmarke">
    <p>„Die größte ungenutzte Ressource eines Unternehmens sind seine eigenen Menschen.“</p>
  </section>

  <section class="wirkung-cta">
    <p>
      <strong>Di-CoCo begleitet diesen Prozess.</strong><br />
      Strategisch, persönlich und mit dem Wissen,<br />was funktioniert und was nicht.
    </p>
    <a href="#leistungen" class="button">Was wir konkret tun</a>
  </section>

  <section class="leistungen" id="leistungen">
    <p class="leistungen__eyebrow">Was Di-CoCo macht</p>
    <h2>Kommunikation, die nach außen wirkt. Weil sie innen verankert ist.</h2>
    <div class="leistungen__grid">
      {cards.map((service) => (
        <article
          class={`leistung-card ${service.data.slug === "schulungen" ? "leistung-card--light" : ""}`}
          style={`--accent: ${colorMap[service.data.color]}`}
        >
          <h3>{service.data.title}</h3>
          <div class="leistung-card__divider"></div>
          <p>
            <strong class="leistung-card__lead">{homepageCardCopy[service.data.slug].lead}</strong>
            {homepageCardCopy[service.data.slug].text}
          </p>
          <div class="leistung-card__actions">
            <a href="#kontakt" class="button--card">Anfragen</a>
            <a href={`/${service.data.slug}/`} class="button--card button--card-ghost">Mehr erfahren</a>
          </div>
        </article>
      ))}
      <div class="leistung-statement">
        <!-- Zeilenumbrüche exakt wie im Webdesign-PDF -->
        <p>
          Di-CoCo begleitet<br />Unternehmen<br />dabei, ihre<br />Kommunikation<br />neu zu denken<br />und
          in die digitale<br />Sichtbarkeit zu<br />führen.
        </p>
        <img src="/assets/logo/Di-CoCo_Bildmarke_3D_B_Gr.svg" alt="" aria-hidden="true" width="670" height="672" />
      </div>
    </div>
  </section>

  <section class="ueber-uns" id="ueber-uns">
    <div class="ueber-uns__head">
      <p class="ueber-uns__eyebrow">Wer hinter Di-CoCo steckt</p>
      <h2>Mehr als zwanzig Jahre Kommunikation. Kein einziger Tag davon war langweilig.</h2>
    </div>
    <div class="ueber-uns__inner">
      <div class="ueber-uns__photo-wrap">
        <img class="ueber-uns__photo" src="/assets/photos/bianca-schiffgens-portrait.webp" alt="Bianca Schiffgens, Gründerin von Di-CoCo" width="1024" height="1024" loading="lazy" />
      </div>
      <div class="ueber-uns__text">
        <p>
          Bianca Schiffgens hat Kommunikation von Grund auf gelernt: in der TV-Produktion in
          Köln, wo jede Geschichte in Sekunden überzeugen muss. In der Agentur im Bereich
          Corporate Communication, wo sie verstanden hat, wie Unternehmen innen ticken und
          wie wenig das oft nach außen sichtbar wird. Als zertifizierter Business-Coach und
          seit 2016 als Gründerin von Di-CoCo, die genau diesen Widerspruch auflöst.
        </p>
        <p>
          Schon lange bevor Corporate Influencing in aller Munde war, hat Bianca mit
          Führungspersönlichkeiten und Teams daran gearbeitet, sichtbar zu werden. Nicht mit
          Hochglanz, sondern durch echte Kommunikation. Di-CoCo arbeitet so, wie gute
          Kommunikation funktioniert: direkt, mit Haltung und immer mit dem Verständnis, dass
          Sichtbarkeit mehr verändert als Reichweite.
        </p>
        <p>
          Di-CoCo begleitet Unternehmen im deutschsprachigen Raum branchenübergreifend, von
          Glasfaser-Infrastruktur über E-Commerce bis Spitzensport. Was alle verbindet: der
          Wunsch nach einer Kommunikation, die wirkt, weil sie echt ist.
        </p>
      </div>
    </div>
    <div class="ueber-uns__credentials">
      {credentials.map((c) => (
        <div class="credential">
          <img src={c.img} alt="" aria-hidden="true" width={c.w} height={c.h} />
          <span>{c.zeilen[0]}<br />{c.zeilen[1]}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="quote-band quote-band--bildmarke-2">
    <p>
      „Corporate Influencer Programme installieren wir nur, wenn die Führung mitmacht und
      vorangeht. Nicht weil wir das so wollen, sondern weil es so am besten funktioniert.“
    </p>
  </section>

  <section class="referenzen" id="referenzen">
    <p class="referenzen__eyebrow">Kundenstimmen</p>
    <h2>Was sich verändert,<br /> wenn <span class="referenzen__brand">Di-CoCo</span> dabei ist.</h2>
    <div class="referenzen__carousel" data-carousel>
      <div class="referenzen__track">
        {referenzen.map((r, i) => (
          <blockquote class="referenz-card" data-slide aria-hidden={i === 0 ? "false" : "true"}>
            <p>„{r.zitat}"</p>
            <cite><strong>{r.name}</strong>{r.rolle}</cite>
          </blockquote>
        ))}
      </div>
      <div class="referenzen__dots" role="tablist" aria-label="Kundenstimmen auswählen">
        {referenzen.map((_, i) => (
          <button type="button" class="referenzen__dot" data-dot aria-label={`Kundenstimme ${i + 1}`} aria-current={i === 0 ? "true" : "false"}></button>
        ))}
      </div>
    </div>
    <div class="branchen-marquee" style={`--branchen-anzahl: ${branchen.length}`}>
      <div class="branchen-marquee__track">
        {[0, 1].map((kopie) => (
          <ul class="branchen-marquee__gruppe" aria-hidden={kopie === 1 ? "true" : undefined}>
            {branchen.map((b) => <li class="pill">{b}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <section class="presse">
    <blockquote class="presse__pullquote gradient-text gradient-text--script">
      „Wer nicht mitmacht, macht den Weg frei für Mitbewerber.“
      <cite>Bianca Schiffgens, Gründerin Di-CoCo</cite>
    </blockquote>
    <div class="presse__buch">
      <div>
        <p class="presse__buch-eyebrow">Buchpublikation</p>
        <h3 class="presse__buch-label">Autorin · Führung im Wandel<br />Springer Gabler Verlag</h3>
        <p>„Führung im Wandel“ ist das neue Fachbuch von Springer Gabler mit Beiträgen von führenden Kommunikationsexperten. Bianca Schiffgens zeigt, wie Sichtbarkeit zur Führungsaufgabe wird.</p>
      </div>
      <a href="https://amzn.to/3SH3g7L" target="_blank" rel="noopener sponsored">
        <img src="/assets/badges/buch-fuehrung-im-wandel.webp" alt="Buchcover Führung im Wandel, Springer Gabler Verlag" width="262" height="367" loading="lazy" />
      </a>
    </div>
  </section>

  <ContactSection />
</Layout>

<style>
  /* Proportionen nach 2026_07_21_Di-CoCo_Webdesign.pdf (1080 pt breit):
     Band nimmt rechts 50,4 % der Breite ein und endet unten exakt an der schwarzen Kante. */
  .hero {
    --ribbon-breite: min(50.4%, 780px);

    position: relative;
    background: var(--color-bg-dark);
    color: var(--color-white);
    /* Höhe so, dass das ganze Band (Seitenverhältnis 544:556) Platz hat */
    min-height: min(54vw, 840px);
    padding: 6.5rem 1.5rem 9rem;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero__content {
    max-width: 680px;
    text-align: left;
  }

  .hero__ribbon {
    position: absolute;
    right: 0;
    bottom: 0;
    width: var(--ribbon-breite);
    height: auto;
    pointer-events: none;
  }

  .hero__badge {
    position: absolute;
    right: max(1.5rem, calc((100% - var(--max-width)) / 2));
    bottom: clamp(1.5rem, 3.7vw, 2.75rem);
    width: clamp(110px, 13.3vw, 170px);
  }

  .hero__scroll {
    position: absolute;
    left: calc(50% - 22px);
    bottom: 2rem;
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(253, 253, 253, 0.5);
    border-radius: 50%;
    color: var(--color-white);
    animation: hero-scroll-bounce 2s ease-in-out infinite;
  }

  @keyframes hero-scroll-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      animation: none;
    }
  }

  .hero__eyebrow {
    color: var(--color-orange);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    margin: 0 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 5.5vw, 4.75rem);
    margin: 0 0 1.5rem;
  }

  .hero__orange {
    color: var(--color-orange);
  }

  /* Dünne orange Schrift flimmert auf Schwarz (gesättigtes Orange "überstrahlt").
     Medium-Schnitt gibt den Strichen genug Fläche, damit sie ruhig und scharf stehen. */
  .hero__subline .hero__orange,
  .wirkung .hl,
  .wirkung__eyebrow,
  .referenzen__eyebrow {
    font-weight: var(--font-weight-medium);
  }

  /* Gedimmt über die Textfarbe statt opacity – opacity würde die orangen Passagen mit abdunkeln */
  .hero__subline {
    font-size: 1.15rem;
    color: rgba(253, 253, 253, 0.85);
    max-width: 560px;
    margin: 0;
  }

  .claim {
    background: var(--color-white);
    padding: 4.5rem 1.5rem 6rem;
    text-align: center;
  }

  /* Größe nach Webdesign-PDF: der Schriftzug nimmt rund 77 % der Seitenbreite ein.
     Padding gibt den überstehenden Pinselstrichen Raum – bei background-clip: text
     würde alles außerhalb der Box sonst unsichtbar. */
  .claim__text {
    font-size: clamp(4rem, 18.7vw, 17.5rem);
    line-height: 0.68;
    padding: 0.18em 0.08em 0.2em;
    margin: 0 0 2.25rem;
  }

  .claim__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .button {
    display: inline-block;
    background: var(--color-orange);
    color: var(--color-white);
    text-decoration: none;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-button);
    font-weight: var(--font-weight-semibold);
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .button:hover {
    background: #e64300;
  }

  .button--outline {
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid rgba(17, 18, 25, 0.25);
  }

  .button--outline:hover {
    border-color: rgba(17, 18, 25, 0.5);
  }

  .link-arrow {
    color: var(--color-blue);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .bekannt-aus {
    background: #f5f5f5;
    /* Kein seitliches Padding: die Logoleiste läuft über die volle Breite */
    padding: 3.5rem 0;
    text-align: center;
  }

  .bekannt-aus__label {
    text-transform: uppercase;
    color: var(--color-blue);
    font-size: 1.15rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    padding-inline: 1.5rem;
    margin: 0 0 2rem;
  }

  .ergebnisse {
    background: #fff;
    color: var(--color-black);
    padding: 6rem 0 7rem;
  }

  .ergebnisse__label {
    padding-inline: 1.5rem;
    text-align: center;
    color: var(--color-orange);
    font-size: 1.15rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 3.5rem;
  }

  .wirkung {
    background: var(--color-bg-dark);
    color: var(--color-white);
    padding: 6.5rem 1.5rem 3rem;
  }

  .wirkung__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .wirkung__eyebrow {
    color: var(--color-orange);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .wirkung h2 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
