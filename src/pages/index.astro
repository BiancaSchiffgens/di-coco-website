---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";

const services = await getCollection("services");

const cardOrder = [
  "corporate-influencer-programme",
  "linkedin-account-management",
  "cxo-communication",
  "keynotes",
  "schulungen",
];
const cards = cardOrder.map((slug) => services.find((s) => s.data.slug === slug)!);

const colorMap: Record<string, string> = {
  orange: "var(--color-orange)",
  blau: "var(--color-blue)",
  violett: "var(--color-violet)",
  schwarz: "var(--color-black)",
};

// Homepage-Card-Copy weicht bewusst von heroSubline der Unterseite ab – exakter Text aus 2026_07_21_Di-CoCo_Webdesign.pdf
const homepageCardCopy: Record<string, string> = {
  "corporate-influencer-programme":
    "Deine Mitarbeitenden sind dein stärkster Kanal. Du nutzt ihn noch nicht. Ein CI-Programm ist kein Social-Media-Projekt. Es ist ein strategischer Eingriff in die Art, wie dein Unternehmen kommuniziert – und wie es intern funktioniert. Wir entwickeln Programme, die Mitarbeitende zu sichtbaren Stimmen machen, Silos aufbrechen und echten Kulturwandel bringen.",
  "linkedin-account-management":
    "Sichtbarkeit entsteht nicht durch Zufallsposts. Sondern durch Strategie. Di-CoCo übernimmt das vollständige strategische Management von LinkedIn-Accounts – für Führungspersönlichkeiten und Unternehmen, die sichtbar sein wollen ohne sich täglich damit zu beschäftigen.",
  "cxo-communication":
    "Führungskräfte, die kommunizieren, führen anders. Wer als Führungspersönlichkeit sichtbar ist, schafft Vertrauen im Markt, Orientierung im Team und Relevanz in der Branche. Di-CoCo entwickelt Positionierung, Messaging und Content – damit deine Stimme nach dir klingt und Wirkung erzeugt.",
  "keynotes":
    "Themen die Entscheider bewegen. Vorträge die nachhalten. Bianca Schiffgens spricht auf Konferenzen und Events zu Sichtbarkeit als Führungsaufgabe, Corporate Influencer Programmen und LinkedIn-Strategie. Kein Theorie-Vortrag. Echte Fälle, klare Haltung, konkrete Empfehlungen.",
  "schulungen":
    "Das Programm läuft. Jetzt muss dein Team es tragen können. Di-CoCo schult Kommunikationsverantwortliche, HR-Teams und interne Programm-Manager, damit sie Corporate Influencer Programme eigenständig begleiten und weiterentwickeln können.",
};

const ergebnisse = [
  { zahl: "8.000+", label: "Follower in der Zielgruppe", kontext: "Corporate Influencerin aufgebaut – von Null" },
  { zahl: "220.000", label: "Impressionen in 5 Monaten", kontext: "E-Commerce-Unternehmen – von Null aufgebaut" },
  { zahl: "10.000+", label: "Follower", kontext: "E-Commerce-Unternehmen nach 5 Monaten Begleitung" },
  { zahl: "5 Jahre", label: "Längste aktive Kundenbeziehung", kontext: "im laufenden Account Management" },
  { zahl: "1.000+", label: "Zuhörer", kontext: "Keynote zu Corporate Communication und digitaler Sichtbarkeit" },
];

const referenzen = [
  {
    zitat: "Das Corporate Influencer Programm hat unsere Markenbekanntheit deutlich gesteigert. Die professionelle Begleitung hat nicht nur unsere Online-Präsenz optimiert, sondern auch intern eine neue Dynamik geschaffen.",
    name: "W. Weigel",
    rolle: "Geschäftsführer, Filoform GmbH · Glasfaser & Infrastruktur",
  },
  {
    zitat: "Bianca hat es geschafft, meine Werte und Ziele authentisch zu transportieren und eine nachhaltige Verbindung zu meiner Zielgruppe aufzubauen. Von der Skeptikerin zur überzeugten LinkedIn-Nutzerin.",
    name: "H. Henkel",
    rolle: "Olympiasiegerin, Keynote-Speakerin & Autorin",
  },
  {
    zitat: "Biancas lockere und mitreißende Art gibt dem sehr professionellen Rahmen die besondere Note. Eines unserer Highlights im Jahr 2024.",
    name: "J. Mina-Knopp",
    rolle: "Geschäftsführerin, Mariposa GmbH",
  },
];

const branchen = ["Industrie", "Technologie", "Beratung", "Finanzdienstleistung", "Energie", "Spitzensport", "E-Commerce"];

const presse = [
  { src: "/assets/press/bild.webp", w: 306, h: 305, quelle: "BILD / BILD Online / BILD.de", kontext: "Bianca Schiffgens als Expertin zur Social-Media-Kommunikation in Insolvenzsituationen" },
  { src: "/assets/press/gruendermagazin.webp", w: 590, h: 143, quelle: "Gründermagazin", kontext: "Corporate Influencer Programme und digitale Sichtbarkeit im Mittelstand" },
  { src: "/assets/press/rheinzeiger.webp", w: 257, h: 287, quelle: "Rheinzeiger", kontext: "Top-10-Kommunikationsexpertin Deutschland 2025" },
  { src: "/assets/press/djv-nrw-journal.webp", w: 737, h: 131, quelle: "DJV NRW Journal", kontext: "Strategische Unternehmenskommunikation und LinkedIn im B2B" },
];

const bekanntAusLogos = [
  { src: "/assets/press/bild.webp", w: 306, h: 305, alt: "BILD" },
  { src: "/assets/press/gruendermagazin.webp", w: 590, h: 143, alt: "Gründermagazin" },
  { src: "/assets/press/rheinzeiger.webp", w: 257, h: 287, alt: "Rheinzeiger" },
  { src: "/assets/press/djv-nrw-journal.webp", w: 737, h: 131, alt: "DJV NRW Journal" },
  { src: "/assets/press/springer-gabler.webp", w: 584, h: 135, alt: "Springer Gabler" },
];

const credentials = [
  { img: "/assets/badges/certified-linkedin-insider.webp", w: 459, h: 359, label: "Certified LinkedIn Marketing Insider" },
  { img: "/assets/badges/favikon-top10-black.webp", w: 369, h: 365, label: "Favikon Top 10 Communications Experts Germany 2025" },
  { img: "/assets/badges/buch-fuehrung-im-wandel.webp", w: 262, h: 367, label: "Autorin Springer Gabler Verlag" },
  { img: "/assets/badges/icon-linkedin.webp", w: 340, h: 346, label: "ca. 24.000 LinkedIn-Follower" },
];
---

<Layout
  title="Di-CoCo – Corporate Influencer Programme und LinkedIn-Strategie für Führungskräfte"
  description="Di-CoCo entwickelt Corporate Influencer Programme und LinkedIn-Strategien für Führungskräfte im deutschsprachigen Raum. Strategisch. Messbar. Mit echtem Kulturwandel."
>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__content">
        <p class="hero__eyebrow">Corporate Visibility Strategist</p>
        <h1><span class="hero__white">Sichtbar werden.</span><br /><span class="hero__orange">Etwas bewegen.</span></h1>
        <p class="hero__subline">
          Di-CoCo begleitet Führungspersönlichkeiten <br class="hero__subline-break" />und Unternehmen im deutschsprachigen Raum, <br class="hero__subline-break" />die wissen, dass Kommunikation mehr kann <br class="hero__subline-break" />als Reichweite zu erzeugen. <span class="hero__orange">Mit der richtigen <br class="hero__subline-break" />Strategie verändert Sichtbarkeit nicht nur, wie <br class="hero__subline-break" />ein Unternehmen wahrgenommen wird – sie <br class="hero__subline-break" />verändert, wie es sich selbst versteht.</span>
        </p>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <img class="hero__ribbon" src="/assets/decor/hero-ribbon.webp" alt="" width="1390" height="1150" />
        <img class="hero__badge" src="/assets/badges/favikon-top10-white.svg" alt="" width="512" height="512" />
      </div>
    </div>
    <a href="#claim" class="hero__scroll" aria-label="Nach unten scrollen">
      <svg width="16" height="9" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section class="claim" id="claim">
    <p class="claim__text gradient-text gradient-text--script">Visibility Drives<br />Business.</p>
    <div class="claim__actions">
      <a href="#kontakt" class="button">Lass uns sprechen</a>
      <a href="#leistungen" class="button button--outline">Was wir tun</a>
    </div>
  </section>

  <section class="bekannt-aus">
    <p class="bekannt-aus__label">Bekannt aus</p>
    <div class="bekannt-aus__logos">
      {bekanntAusLogos.map((logo) => (
        <img src={logo.src} alt={logo.alt} width={logo.w} height={logo.h} loading="lazy" />
      ))}
    </div>
    <p class="bekannt-aus__badge">Favikon Top 10 Communications Experts Germany 2025</p>
  </section>

  <section class="ergebnisse">
    <p class="ergebnisse__label">Was wir für unsere Kunden erreichen</p>
    <div class="ergebnisse__grid">
      {ergebnisse.map((e) => (
        <div class="ergebnisse__item">
          <p class="ergebnisse__zahl gradient-text">{e.zahl}</p>
          <p class="ergebnisse__item-label">{e.label}</p>
          <p class="ergebnisse__kontext">{e.kontext}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wirkung">
    <div class="wirkung__inner">
      <p class="wirkung__eyebrow">Was wirklich passiert, wenn Kommunikation funktioniert</p>
      <h2>Die meisten Unternehmen unterschätzen, was Sichtbarkeit auslösen kann.</h2>
      <div class="wirkung__grid">
        <div class="wirkung__col">
          <div class="wirkung__divider"></div>
          <p>
            Nicht weil sie es nicht wissen wollen. Sondern weil Kommunikation in vielen
            Organisationen noch immer als Aufgabe einer Abteilung gilt – und nicht
            <span class="hl">als strategisches Instrument das auf Führungsebene angesiedelt
            sein muss</span>.
          </p>
          <p class="wirkung__label gradient-text--script">Der<br /><span class="gradient-text">interne</span><br />Effekt</p>
        </div>
        <div class="wirkung__col">
          <div class="wirkung__divider"></div>
          <p>
            Menschen vertrauen heute nicht mehr Logos. Sie vertrauen Menschen.
            <span class="hl">Wenn Führungskräfte und Mitarbeitende eine echte Stimme
            entwickeln, verändert sich mehr als die Außenwirkung</span>. Es entsteht Vertrauen
            – im Markt, im Netzwerk und in der Organisation selbst.
          </p>
          <p>
            Und hier passiert etwas, das wir immer wieder erleben und das unsere Kunden
            regelmäßig überrascht: <span class="hl">Wenn ein Corporate Influencer Programm gut
            angelegt ist, bricht es Silos auf</span>. Menschen aus verschiedenen Abteilungen
            lernen voneinander. Interne Netzwerke entstehen neu. Mitarbeitende fühlen sich
            gesehen, weil ihre Expertise plötzlich nach außen zählt.
            <span class="hl">Was als Kommunikationsprojekt beginnt, wird zu echtem
            Kulturwandel</span>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-band">
    <p>„Die größte ungenutzte Ressource eines Unternehmens sind seine eigenen Menschen.“</p>
  </section>

  <section class="wirkung-cta">
    <p>Di-CoCo begleitet diesen Prozess.<br />Strategisch, persönlich und mit dem Wissen, was funktioniert – und was nicht.</p>
    <a href="#leistungen" class="button">Was wir konkret tun</a>
  </section>

  <section class="leistungen" id="leistungen">
    <p class="leistungen__eyebrow">Was Di-CoCo macht</p>
    <h2>Kommunikation, die nach außen wirkt. Weil sie innen verankert ist.</h2>
    <div class="leistungen__grid">
      {cards.map((service) => (
        <article
          class={`leistung-card ${service.data.slug === "schulungen" ? "leistung-card--light" : ""}`}
          style={`--accent: ${colorMap[service.data.color]}`}
        >
          <h3>{service.data.title}</h3>
          <div class="leistung-card__divider"></div>
          <p>{homepageCardCopy[service.data.slug]}</p>
          <div class="leistung-card__actions">
            <a href="#kontakt" class="button--card">Anfragen</a>
            <a href={`/${service.data.slug}/`} class="button--card button--card-ghost">Mehr erfahren</a>
          </div>
        </article>
      ))}
      <div class="leistung-statement">
        <p class="gradient-text">
          Di-CoCo begleitet Unternehmen dabei, ihre Kommunikation neu zu denken und in die
          digitale Sichtbarkeit zu führen.
        </p>
        <img src="/assets/logo/Di-CoCo_Bildmarke_3D_B_Gr.svg" alt="" aria-hidden="true" width="670" height="672" />
      </div>
    </div>
  </section>

  <section class="ueber-uns" id="ueber-uns">
    <div class="ueber-uns__inner">
      <img class="ueber-uns__photo" src="/assets/photos/bianca-schiffgens.webp" alt="Bianca Schiffgens, Gründerin von Di-CoCo" width="1200" height="1200" loading="lazy" />
      <div class="ueber-uns__text">
        <p class="ueber-uns__eyebrow">Wer hinter Di-CoCo steckt</p>
        <h2>Mehr als zwanzig Jahre Kommunikation. Kein einziger Tag davon war langweilig.</h2>
        <p>
          Bianca Schiffgens hat Kommunikation von Grund auf gelernt – in der TV-Produktion in
          Köln, wo jede Geschichte in Sekunden überzeugen muss. In der Agentur im Bereich
          Corporate Communication, wo sie verstanden hat, wie Unternehmen innen ticken und
          wie wenig das oft nach außen sichtbar wird. Als zertifizierter Business-Coach und
          seit 2016 als Gründerin von Di-CoCo, die genau diesen Widerspruch auflöst.
        </p>
        <p>
          Schon lange bevor Corporate Influencing in aller Munde war, hat Bianca mit
          Führungspersönlichkeiten und Teams daran gearbeitet, sichtbar zu werden. Nicht mit
          Hochglanz sondern durch echte Kommunikation. Di-CoCo arbeitet so, wie gute
          Kommunikation funktioniert: direkt, mit Haltung und immer mit dem Verständnis, dass
          Sichtbarkeit mehr verändert als Reichweite.
        </p>
        <p>
          Di-CoCo begleitet Unternehmen im deutschsprachigen Raum branchenübergreifend – von
          Glasfaser-Infrastruktur über E-Commerce bis Spitzensport. Was alle verbindet: der
          Wunsch nach einer Kommunikation die wirkt, weil sie echt ist.
        </p>
        <div class="ueber-uns__credentials">
          {credentials.map((c) => (
            <div class="credential">
              <img src={c.img} alt="" aria-hidden="true" width={c.w} height={c.h} />
              <span>{c.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="quote-band">
    <p>
      „Corporate Influencer Programme installieren wir nur, wenn die Führung mitmacht und
      vorangeht. Nicht weil wir das so wollen. Sondern weil so am besten funktioniert.“
    </p>
  </section>

  <section class="referenzen" id="referenzen">
    <p class="referenzen__eyebrow">Kundenstimmen</p>
    <h2>Was sich verändert, wenn <span class="referenzen__brand">Di-CoCo</span> dabei ist.</h2>
    <div class="referenzen__carousel" data-carousel>
      <div class="referenzen__track">
        {referenzen.map((r, i) => (
          <blockquote class="referenz-card" data-slide aria-hidden={i === 0 ? "false" : "true"}>
            <p>„{r.zitat}"</p>
            <cite>{r.name}, {r.rolle}</cite>
          </blockquote>
        ))}
      </div>
      <div class="referenzen__dots" role="tablist" aria-label="Kundenstimmen auswählen">
        {referenzen.map((_, i) => (
          <button type="button" class="referenzen__dot" data-dot aria-label={`Kundenstimme ${i + 1}`} aria-current={i === 0 ? "true" : "false"}></button>
        ))}
      </div>
    </div>
    <div class="referenzen__badges">
      {branchen.map((b) => <span class="pill">{b}</span>)}
    </div>
  </section>

  <section class="presse" id="presse">
    <p class="presse__eyebrow">Presse</p>
    <h2>Di-CoCo in den Medien.</h2>
    <div class="presse__grid">
      {presse.map((p) => (
        <div class="presse__item">
          <img src={p.src} alt={p.quelle} width={p.w} height={p.h} loading="lazy" />
          <p>{p.kontext}</p>
        </div>
      ))}
    </div>
    <blockquote class="presse__pullquote gradient-text gradient-text--script">
      „Wer nicht mitmacht, macht den Weg frei für Mitbewerber.“
      <cite>Bianca Schiffgens, Gründerin Di-CoCo</cite>
    </blockquote>
    <div class="presse__buch">
      <div>
        <p class="presse__buch-eyebrow">Buchpublikation</p>
        <h3 class="presse__buch-label">Autorin · Führung im Wandel<br />Springer Gabler Verlag</h3>
        <p>„Führung im Wandel“ – das neue Fachbuch von Springer Gabler mit Beiträgen von führenden Kommunikationsexperten. Bianca Schiffgens zeigt, wie Sichtbarkeit zur Führungsaufgabe wird.</p>
      </div>
      <img src="/assets/badges/buch-fuehrung-im-wandel.webp" alt="Buchcover Führung im Wandel, Springer Gabler Verlag" width="262" height="367" loading="lazy" />
    </div>
  </section>

  <ContactSection />
</Layout>

<style>
  .hero {
    position: relative;
    background: var(--color-black);
    color: var(--color-white);
    padding: 6.5rem 1.5rem;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 680px) 1fr;
    align-items: end;
    gap: 2rem;
  }

  .hero__content {
    text-align: left;
  }

  .hero__visual {
    position: relative;
    height: 100%;
    min-height: 560px;
    margin-bottom: -6.5rem;
  }

  .hero__ribbon {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 140%;
    max-width: 680px;
    transform: translateX(-50%);
    opacity: 0.9;
    pointer-events: none;
  }

  .hero__badge {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 170px;
  }

  .hero__scroll {
    position: relative;
    display: flex;
    width: 44px;
    height: 44px;
    margin: 3.5rem auto 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(253, 253, 253, 0.5);
    border-radius: 50%;
    color: var(--color-white);
    animation: hero-scroll-bounce 2s ease-in-out infinite;
  }

  @keyframes hero-scroll-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      animation: none;
    }
  }

  .hero__eyebrow {
    color: var(--color-orange);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    margin: 0 0 1.5rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 5.5vw, 4.75rem);
    margin: 0 0 1.5rem;
  }

  .hero__orange {
    color: var(--color-orange);
  }

  .hero__subline {
    font-size: 1.15rem;
    opacity: 0.85;
    max-width: 560px;
    margin: 0;
  }

  .claim {
    background: var(--color-white);
    padding: 5.5rem 1.5rem 6.5rem;
    text-align: center;
  }

  .claim__text {
    font-size: clamp(3rem, 11vw, 9rem);
    line-height: 0.95;
    max-width: 1080px;
    margin: 0 0 3rem;
  }

  .claim__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .button {
    display: inline-block;
    background: var(--color-orange);
    color: var(--color-white);
    text-decoration: none;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-button);
    font-weight: var(--font-weight-semibold);
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .button:hover {
    background: #e64300;
  }

  .button--outline {
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid rgba(17, 18, 25, 0.25);
  }

  .button--outline:hover {
    border-color: rgba(17, 18, 25, 0.5);
  }

  .link-arrow {
    color: var(--color-blue);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .bekannt-aus {
    background: #f5f5f5;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .bekannt-aus__label {
    text-transform: uppercase;
    color: var(--color-blue);
    font-size: 0.8rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    margin: 0 0 1.25rem;
  }

  .bekannt-aus__logos {
    display: flex;
    align-items: center;
    gap: 3rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0 0 1.25rem;
  }

  .bekannt-aus__logos img {
    height: 40px;
    width: auto;
  }

  .bekannt-aus__badge {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
  }

  .ergebnisse {
    background: #fff;
    color: var(--color-black);
    padding: 6rem 1.5rem 7rem;
  }

  .ergebnisse__label {
    text-align: center;
    color: var(--color-orange);
    font-size: 1.05rem;
    font-weight: var(--font-weight-bold);
    margin: 0 0 3.5rem;
  }

  /* 6 Spalten, damit Reihe 1 drei Items (je 2 Spalten) trägt und Reihe 2
     zwei Items mittig sitzen (Versatz um eine Spalte). */
  .ergebnisse__grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3.5rem 2rem;
    text-align: center;
  }

  .ergebnisse__item {
    grid-column: span 2;
  }

  .ergebnisse__item:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .ergebnisse__zahl {
    font-size: clamp(2.75rem, 8vw, 5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-headline);
    margin: 0 0 2rem;
  }

  /* Textmaß schmaler als die Spalte, damit die Zeilen wie im Design umbrechen */
  .ergebnisse__item-label,
  .ergebnisse__kontext {
    max-width: 21rem;
    margin-inline: auto;
    font-size: 1.25rem;
    line-height: var(--line-height-copy);
    text-wrap: balance;
  }

  .ergebnisse__item-label {
    font-weight: var(--font-weight-bold);
    margin-block: 0;
  }

  .ergebnisse__kontext {
    margin-block: 0;
  }

  .wirkung {
    background: var(--color-black);
    color: var(--color-white);
    padding: 6.5rem 1.5rem 4rem;
  }

  .wirkung__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .wirkung__eyebrow {
