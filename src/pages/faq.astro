const linkMap = [
  { phrase: "Corporate Influencer Programm", href: "/corporate-influencer-programme" },
  { phrase: "CXO Communication", href: "/cxo-communication" },
  { phrase: "LinkedIn Account Management", href: "/linkedin-account-management" },
  { phrase: "Keynotes", href: "/keynotes" },
  { phrase: "Schulungen", href: "/schulungen" },
  { phrase: "Bianca Schiffgens", href: "/#ueber-uns" },
];

function escapeHtml(str: string) {
  return str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

const usedLinks = new Set<string>();

function linkify(text: string) {
  let html = escapeHtml(text);
  for (const { phrase, href } of linkMap) {
    if (usedLinks.has(phrase)) continue;
    if (html.includes(phrase)) {
      html = html.replace(phrase, `<a href="${href}">${phrase}</a>`);
      usedLinks.add(phrase);
    }
  }
  return html;
}

const categoriesWithHtml = categories.map((cat) => ({
  ...cat,
  qa: cat.qa.map((item) => ({
    ...item,
    antwortHtml: linkify(item.antwort),
  })),
}));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: categories.flatMap((cat) =>
    cat.qa.map((f) => ({
      "@type": "Question",
      name: f.frage,
      acceptedAnswer: { "@type": "Answer", text: f.antwort },
    }))
  ),
};

const breadcrumb = [
  { name: "Startseite", url: "/" },
  { name: "FAQ", url: "/faq" },
];
---

<Layout
  title="Häufige Fragen zu Corporate Influencer Programmen | Di-CoCo"
  description="Antworten auf die häufigsten Fragen zu Corporate Influencer Programmen: Ablauf, Kosten, Ergebnisse, Voraussetzungen, CXO Communication, Keynotes und Schulungen."
  breadcrumb={breadcrumb}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <section class="faq">
    <div class="faq__inner">
      <h1>Häufige Fragen zu Corporate Influencer Programmen</h1>
      <p class="faq__intro">
        Antworten auf die Fragen, die uns Unternehmen und Führungskräfte am häufigsten stellen – von den
        Grundlagen über Ablauf und Kosten bis zu Ergebnissen, CXO Communication und Keynotes.
      </p>

      <nav class="faq__nav" aria-label="Kategorien">
        {categories.map((cat) => (
          <a href={`#${cat.slug}`}>{cat.title}</a>
        ))}
      </nav>

      {categoriesWithHtml.map((cat) => (
        <div class="faq__category" id={cat.slug}>
          <h2>{cat.title}</h2>
          <p class="faq__category-tagline">{cat.tagline}</p>
          {cat.qa.map((f) => (
            <details class="faq__item">
              <summary><h3>{f.frage}</h3></summary>
              <p set:html={f.antwortHtml} />
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .faq {
    padding: 5rem 1.5rem;
  }

  .faq__inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .faq h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
  }

  .faq__intro {
    opacity: 0.85;
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 0 2.5rem;
  }

  .faq__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 0 0 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(17, 18, 25, 0.1);
  }

  .faq__nav a {
    font-size: 0.9rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-blue);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(17, 18, 25, 0.15);
    border-radius: 999px;
  }

  .faq__nav a:hover {
    background: rgba(17, 18, 25, 0.05);
  }

  .faq__category {
    margin: 0 0 3.5rem;
    scroll-margin-top: 2rem;
  }

  .faq__category h2 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    margin: 0 0 0.35rem;
  }

  .faq__category-tagline {
    opacity: 0.7;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  .faq__item {
    border-bottom: 1px solid rgba(17, 18, 25, 0.1);
    padding: 1.25rem 0;
  }

  .faq__item summary {
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary h3 {
    display: inline;
    font-weight: var(--font-weight-semibold);
    font-size: 1.05rem;
    margin: 0;
  }

  .faq__item summary::before {
    content: "+";
    display: inline-block;
    width: 1.1rem;
    color: var(--color-blue);
    font-weight: var(--font-weight-semibold);
  }

  .faq__item[open] summary::before {
    content: "–";
  }

  .faq__item p {
    margin: 1rem 0 0;
    opacity: 0.85;
  }

  .faq__item p :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
  }
</style>
