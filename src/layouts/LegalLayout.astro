---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="legal">
    <div class="legal__inner">
      <slot />
    </div>
  </section>
</Layout>

<style>
  .legal {
    padding: 5rem 1.5rem;
  }

  .legal__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .legal__inner :global(h1) {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 2rem;
  }

  .legal__inner :global(h2) {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
  }

  .legal__inner :global(h3) {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.5rem;
  }

  .legal__inner :global(p) {
    margin: 0 0 1rem;
    opacity: 0.85;
  }

  .legal__inner :global(ul) {
    padding-left: 1.25rem;
    opacity: 0.85;
  }

  .legal__inner :global(a) {
    color: var(--color-blue);
  }
</style>
