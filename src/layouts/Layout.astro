---
import "../styles/tokens.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  breadcrumb?: { name: string; url: string }[];
}

const { title, description, breadcrumb } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Di-CoCo",
  url: "https://di-coco.com",
  logo: "https://di-coco.com/assets/logo.svg",
  sameAs: [
    "https://www.linkedin.com/company/di-coco",
    "https://www.linkedin.com/in/biancaschiffgens",
  ],
  areaServed: "DACH",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bianca Schiffgens",
  jobTitle: "Corporate Visibility Strategist",
  worksFor: { "@type": "Organization", name: "Di-CoCo" },
  sameAs: ["https://www.linkedin.com/in/biancaschiffgens"],
};

const breadcrumbSchema = breadcrumb
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumb.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.name,
        item: new URL(item.url, Astro.site).toString(),
      })),
    }
  : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/Di-CoCo_Bildmarke_2D_B.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/assets/og-image.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
