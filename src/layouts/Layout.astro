---
import "../styles/tokens.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";

interface Props {
  title: string;
  description: string;
  breadcrumb?: { name: string; url: string }[];
}

const { title, description, breadcrumb } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Angaben zu Di-CoCo und Bianca für Suchmaschinen und KI-Assistenten.
// Nur Fakten, die auch sichtbar auf der Seite stehen (Startseite, Presse, Impressum).
const ORG_ID = "https://di-coco.com/#organisation";
const PERSON_ID = "https://di-coco.com/#bianca-schiffgens";

const adresse = {
  "@type": "PostalAddress",
  streetAddress: "Hetzenholz 9",
  postalCode: "53804",
  addressLocality: "Much",
  addressCountry: "DE",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": ORG_ID,
  name: "Di-CoCo",
  url: "https://di-coco.com",
  logo: "https://di-coco.com/assets/logo/Di-CoCo_Wortmarke_Black.svg",
  description:
    "Di-CoCo entwickelt Corporate Influencer Programme und LinkedIn-Strategien für Führungskräfte im deutschsprachigen Raum.",
  foundingDate: "2016",
  founder: { "@id": PERSON_ID },
  address: adresse,
  email: "hello@di-coco.com",
  telephone: "+49 178 7260884",
  sameAs: [
    "https://www.linkedin.com/company/18448549/",
    "https://www.linkedin.com/in/bianca-schiffgens-corporate-influencer-programme/",
  ],
  areaServed: "DACH",
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": PERSON_ID,
  name: "Bianca Schiffgens",
  jobTitle: "Corporate Visibility Strategist",
  description:
    "Expertin für digitale Kommunikation und Gründerin von Di-CoCo. Schwerpunkte: Corporate-Influencer-Programme, digitale Sichtbarkeit und CEO-Kommunikation.",
  image: "https://di-coco.com/assets/photos/bianca-schiffgens-portrait.webp",
  url: "https://di-coco.com/#ueber-uns",
  worksFor: { "@id": ORG_ID },
  knowsAbout: [
    "Corporate Influencer Programme",
    "CEO-Kommunikation",
    "LinkedIn-Strategie für Führungskräfte",
    "Social Selling",
    "Digitale Sichtbarkeit",
    "Unternehmenskommunikation",
  ],
  award: "Favikon Top 10 Communications Experts Germany 2025 & 2026",
  sameAs: ["https://www.linkedin.com/in/bianca-schiffgens-corporate-influencer-programme/"],
};


const breadcrumbSchema = breadcrumb
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumb.map((item, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: item.name,
        item: new URL(item.url, Astro.site).toString(),
      })),
    }
  : null;
---

<!doctype html>
<html lang="de">
  <head>
    <!-- Markiert früh, dass JavaScript läuft. Ohne JS zeigen Bausteine wie der "Wir sind"-Wort-Wechsel gleich ihren Endzustand. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/Di-CoCo_Bildmarke_2D_B.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Di-CoCo" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/assets/og-image-wir-sind.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wir sind Di-CoCo. Visibility drives business." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/assets/og-image-wir-sind.png", Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
