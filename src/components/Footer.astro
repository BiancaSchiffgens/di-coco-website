---
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col">
      <a href="/" class="footer__logo-lockup">
        <span class="footer__logo-row">
          <img class="footer__logo-mark" src="/assets/logo/Di-CoCo_Bildmarke_2D_W.svg" alt="" aria-hidden="true" width="40" height="40" />
          <img class="footer__logo-word" src="/assets/logo/Di-CoCo_Wortmarke_White.svg" alt="Di-CoCo" width="150" height="45" />
        </span>
        <span class="footer__tagline">Visibility Drives Business</span>
      </a>
      <a
        class="footer__rating"
        href="https://www.provenexpert.com/de-de/dein-bizz/"
        target="_blank"
        rel="noopener"
        aria-label="ProvenExpert-Bewertung: 4,93 von 5, sehr gut, 9 Bewertungen – zum Profil"
      >
        <p class="footer__rating-score">4,93 von 5</p>
        <p class="footer__rating-stars" aria-hidden="true">★★★★★</p>
        <p class="footer__rating-label">SEHR GUT</p>
        <p class="footer__rating-count">9 Bewertungen</p>
      </a>
    </div>

    <div class="footer__col">
      <h3 class="sr-only">Leistungen</h3>
      <ul>
        {services.map((service) => (
          <li><a href={`/${service.data.slug}/`}>{service.data.navLabel}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="sr-only">Unternehmen</h3>
      <ul>
        <li><a href="/#ueber-uns">Über uns</a></li>
        <li><a href="/#referenzen">Referenzen</a></li>
        <li><a href="/#presse">Presse</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/#kontakt">Kontakt</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="sr-only">Kontakt</h3>
      <ul>
        <li>
          <a class="footer__social" href="https://www.linkedin.com/in/bianca-schiffgens-corporate-influencer-programme/" target="_blank" rel="noopener">
            <img src="/assets/logo/linkedin-icon-white.svg" alt="" aria-hidden="true" width="18" height="18" /> Bianca Schiffgens
          </a>
        </li>
        <li>
          <a class="footer__social" href="https://www.linkedin.com/company/di-coco" target="_blank" rel="noopener">
            <img src="/assets/logo/linkedin-icon-white.svg" alt="" aria-hidden="true" width="18" height="18" /> Di-CoCo
          </a>
        </li>
        <li><a href="mailto:hello@di-coco.com">hello@di-coco.com</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p>
      © {year} Di-CoCo – Digital Corporate Communications · Bianca Schiffgens ·
      <a href="/impressum/">Impressum</a> ·
      <a href="/datenschutz/">Datenschutz</a> ·
      <a href="/agb/">AGB</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-black);
    color: var(--color-white);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .footer__logo-lockup {
    display: block;
    opacity: 1;
    margin: 0 0 1.5rem;
  }

  .footer__logo-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer__logo-mark {
    height: 40px;
    width: auto;
  }

  .footer__logo-word {
    height: 30px;
    width: auto;
  }

  .footer__tagline {
    display: block;
    margin-top: 0.4rem;
    font-size: 1.05rem;
    opacity: 0.85;
  }

  .footer__rating {
    display: block;
    background: var(--color-white);
    color: var(--color-black);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    width: fit-content;
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  .footer__rating:hover {
    opacity: 0.85;
  }

  .footer__rating p {
    margin: 0;
  }

  .footer__rating-score {
    color: #c9b274;
    font-size: 0.8rem;
    font-weight: var(--font-weight-semibold);
  }

  .footer__rating-stars {
    color: #c9b274;
    letter-spacing: 0.1em;
    font-size: 1.1rem;
    margin: 0.15rem 0 !important;
  }

  .footer__rating-label {
    color: var(--color-black);
    font-weight: var(--font-weight-bold);
  }

  .footer__rating-count {
    color: var(--color-black);
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer a {
    text-decoration: none;
    color: var(--color-white);
    opacity: 0.85;
  }

  .footer a:hover {
    opacity: 1;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__bottom {
    border-top: 1px solid rgba(253, 253, 253, 0.12);
    padding: 1.25rem 1.5rem;
  }

  .footer__bottom p {
    max-width: var(--max-width);
    margin: 0 auto;
    font-size: 0.85rem;
    opacity: 0.6;
  }

  .footer__bottom a {
    opacity: 1;
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
