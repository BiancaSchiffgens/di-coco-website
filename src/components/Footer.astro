---
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col">
      <a href="/" class="footer__logo-lockup">
        <img class="footer__logo" src="/assets/logo/Di-CoCo_WBM_H_W_tight.svg" alt="Di-CoCo – Visibility Drives Business" width="1248" height="300" />
      </a>
    </div>

    <div class="footer__col">
      <h3 class="sr-only">Leistungen</h3>
      <ul>
        {services.map((service) => (
          <li><a href={`/${service.data.slug}/`}>{service.data.navLabel}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="sr-only">Unternehmen</h3>
      <ul>
        <li><a href="/#ueber-uns">Über uns</a></li>
        <li><a href="/#referenzen">Referenzen</a></li>
        <li><a href="/presse/">Presse</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/#kontakt">Kontakt</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="sr-only">Kontakt</h3>
      <ul>
        <li>
          <a class="footer__social" href="https://www.linkedin.com/in/bianca-schiffgens-corporate-influencer-programme/" target="_blank" rel="noopener">
            <img src="/assets/logo/linkedin-icon-white.svg" alt="" aria-hidden="true" width="18" height="18" /> Bianca Schiffgens
          </a>
        </li>
        <li>
          <a class="footer__social" href="https://www.linkedin.com/company/18448549/" target="_blank" rel="noopener">
            <img src="/assets/logo/linkedin-icon-white.svg" alt="" aria-hidden="true" width="18" height="18" /> Di-CoCo
          </a>
        </li>
        <li><a href="mailto:hello@di-coco.com">hello@di-coco.com</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p>
      © {year} Di-CoCo – Digital Corporate Communications · Bianca Schiffgens ·
      <a href="/impressum/">Impressum</a> ·
      <a href="/datenschutz/">Datenschutz</a> ·
      <a href="/agb/">AGB</a> ·
      <button type="button" class="footer__consent" data-consent-open>Cookie-Einstellungen</button>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-white);
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Wort-Bild-Marke aus dem Design-Ordner (_Logo/_Web/svg/Wort-Bild-Marke/Di-CoCo_WBM_H_W.svg),
     viewBox auf die Tinte zugeschnitten. Breite wie im Webdesign-PDF: 228px. */
  .footer__logo-lockup {
    display: block;
    opacity: 1;
  }

  .footer__logo {
    display: block;
    width: 228px;
    max-width: 100%;
    height: auto;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer a {
    text-decoration: none;
    color: var(--color-white);
    opacity: 0.85;
  }

  .footer a:hover {
    opacity: 1;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__bottom {
    border-top: 1px solid rgba(253, 253, 253, 0.12);
    padding: 1.25rem 1.5rem;
  }

  .footer__bottom p {
    max-width: var(--max-width);
    margin: 0 auto;
    font-size: 0.85rem;
    opacity: 0.6;
  }

  .footer__bottom a,
  .footer__consent {
    opacity: 1;
    text-decoration: underline;
  }

  /* Als Button, weil es kein Ziel öffnet, sondern das Consent-Banner erneut zeigt. */
  .footer__consent {
    font: inherit;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  /* Schmaler: Logo als eigene Zeile oben, die drei Link-Spalten darunter */
  @media (max-width: 860px) {
    .footer__inner {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
    }

    .footer__col:first-child {
      grid-column: 1 / -1;
    }
  }

  /* Handy: Leistungen über die ganze Breite, Unternehmen und Kontakt nebeneinander */
  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__col:nth-child(2) {
      grid-column: 1 / -1;
    }
  }
</style>
