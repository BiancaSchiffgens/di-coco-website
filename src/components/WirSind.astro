---
// "Wir sind …": Begriffe rollen nacheinander von unten ins Bild, am Ende bleibt die Wortmarke stehen.
// Echter Text statt Video, damit Google und Screenreader ihn lesen können.
// Sitzt im schwarzen Hero, deshalb helle Schrift.
import wortmarke from "../../public/assets/logo/Di-CoCo_Wortmarke_Orange_R.svg?raw";

const begriffe = ["Kommunikationsprofis", "LinkedIn-Insider", "Kulturbegleiter", "Klartext", "Rückenwind"];

// Original-Wortmarke mit ® (CI), nur der leere Rand der Zeichenfläche wird weggeschnitten:
// Buchstaben + ® liegen in x 75–963, y 64–230 (Grundlinie bei 228).
// Füllung: Di-CoCo Orange-Blue aus dem Brandbook (Verlaufsmitte bei 66 %), auf Wunsch von Bianca.
// Die Klasse wird umbenannt, weil <style> im SVG sonst seitenweit für alle .cls-1 gelten würde.
const verlauf =
  '<defs><linearGradient id="wir-sind-verlauf" gradientUnits="userSpaceOnUse" x1="75" y1="0" x2="963" y2="0">' +
  '<stop offset="0" stop-color="#ff4b00"/><stop offset="0.66" stop-color="#803e80"/><stop offset="1" stop-color="#0032ff"/>' +
  "</linearGradient></defs>";
const logo = wortmarke
  .replace(/<\?xml[^>]*\?>\s*/, "")
  .replace(/viewBox="[^"]*"/, 'viewBox="75 64 888 166"')
  .replace("<svg ", '<svg class="wir-sind__logo" aria-hidden="true" focusable="false" ')
  .replaceAll("cls-1", "wir-sind-logo-flaeche")
  .replace(/fill:\s*#ff4b00;?/, "fill: url(#wir-sind-verlauf);")
  .replace("<defs>", verlauf.replace("</defs>", ""));
---

<div class="wir-sind" data-wir-sind>
  <p class="visually-hidden">Wir sind {begriffe.join(", ")}. Wir sind Di-CoCo.</p>
  <div aria-hidden="true">
    <p class="wir-sind__intro">Wir sind</p>
    <div class="wir-sind__fenster">
      <ul class="wir-sind__liste">
        {begriffe.map((wort) => <li><span class="wir-sind__wort">{wort}</span></li>)}
        <li><Fragment set:html={logo} /></li>
      </ul>
    </div>
  </div>
</div>

<style>
  .wir-sind {
    /* Größe richtet sich nach dem längsten Begriff (10,8 em breit), damit er auf dem Handy in eine Zeile passt */
    --wort-groesse: clamp(1.375rem, 7.4vw, 3.75rem);
    --zeile: 1.3em;

    margin: 0 0 clamp(4rem, 7vw, 6rem);
    color: var(--color-white);
  }

  .wir-sind__intro {
    font-size: clamp(1.25rem, 2.6vw, 1.85rem);
    font-weight: var(--font-weight-medium);
    color: rgba(253, 253, 253, 0.85);
    margin: 0 0 0.15rem;
  }

  .wir-sind__fenster {
    font-size: var(--wort-groesse);
    height: var(--zeile);
    overflow: hidden;
    transition: opacity 0.4s ease;
  }

  .wir-sind__fenster.ist-weg {
    opacity: 0;
  }

  .wir-sind__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 0.55s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .wir-sind__liste.ohne-uebergang {
    transition: none;
  }

  .wir-sind__liste li {
    height: var(--zeile);
    line-height: 1.1;
    font-weight: var(--font-weight-bold);
    white-space: nowrap;
  }

  .wir-sind__wort {
    position: relative;
    display: inline-block;
  }

  /* Unterstreichung im Markenverlauf, nicht am Logo */
  .wir-sind__wort::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.06em;
    height: 0.07em;
    border-radius: 1em;
    background: linear-gradient(90deg, var(--color-blue) 0%, var(--color-violet) 50%, var(--color-orange) 100%);
  }

  /* Wortmarke als Schlusspunkt größer als die Begriffe: füllt die Zeile fast ganz aus.
     Unterkante = Grundlinie der Wortmarke, ragt wie die Begriffe nicht aus dem Fenster */
  .wir-sind__liste :global(.wir-sind__logo) {
    display: block;
    height: 1.12em;
    width: auto;
    margin-top: 0.06em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Ohne Bewegung: gleich die Wortmarke zeigen */
  @media (prefers-reduced-motion: reduce) {
    .wir-sind__liste {
      transition: none;
      transform: translateY(calc(var(--zeile) * -5));
    }
  }
</style>

<script>
  const STANDZEIT = 1500; // ms pro Begriff
  const SCHLUSS_STANDZEIT = 3500; // ms für die Wortmarke
  const reduziert = matchMedia("(prefers-reduced-motion: reduce)");

  for (const box of document.querySelectorAll<HTMLElement>("[data-wir-sind]")) {
    const fenster = box.querySelector<HTMLElement>(".wir-sind__fenster")!;
    const liste = box.querySelector<HTMLElement>(".wir-sind__liste")!;
    const anzahl = liste.children.length;
    let index = 0;
    let gestartet = false;

    const zeige = (i: number) => {
      liste.style.transform = `translateY(calc(var(--zeile) * ${-i}))`;
    };

    const weiter = () => {
      if (reduziert.matches) {
        zeige(anzahl - 1);
        return;
      }
      if (index < anzahl - 1) {
        index++;
        zeige(index);
        setTimeout(weiter, index === anzahl - 1 ? SCHLUSS_STANDZEIT : STANDZEIT);
      } else {
        // Ausblenden, unsichtbar zurück zum ersten Begriff, wieder einblenden
        fenster.classList.add("ist-weg");
        setTimeout(() => {
          liste.classList.add("ohne-uebergang");
          index = 0;
          zeige(0);
          liste.offsetHeight; // Neuberechnung erzwingen, bevor der Übergang zurückkommt
          liste.classList.remove("ohne-uebergang");
          fenster.classList.remove("ist-weg");
          setTimeout(weiter, STANDZEIT);
        }, 450);
      }
    };

    // Erst starten, wenn der Block sichtbar ist, damit man den Anfang mitbekommt
    const beobachter = new IntersectionObserver((eintraege) => {
      if (eintraege.some((e) => e.isIntersecting) && !gestartet) {
        gestartet = true;
        beobachter.disconnect();
        setTimeout(weiter, STANDZEIT);
      }
    }, { threshold: 0.6 });
    beobachter.observe(box);
  }
</script>
