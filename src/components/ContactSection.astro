---
const FORMSPREE_ENDPOINT = "https://formspree.io/f/mwleglwq";
---

<section class="kontakt" id="kontakt">
  <div class="kontakt__inner">
    <h2>Du machst gute Arbeit. Es ist Zeit, dass mehr Menschen das wissen.</h2>
    <p>
      Di-CoCo begleitet Unternehmen und Führungskräfte im deutschsprachigen Raum, die
      verstanden haben, dass Kommunikation kein Nice-to-have ist. Wenn du für dein
      Unternehmen oder dich selbst mehr Sichtbarkeit und Wirkung willst – schreib uns. Das
      erste Gespräch ist kostenlos, unverbindlich und ohne Pitch.
    </p>

    <form class="kontakt__form" action={FORMSPREE_ENDPOINT} method="POST" data-kontakt-form>
      <input type="text" name="_gotcha" class="kontakt__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="_subject" value="Neue Anfrage über di-coco.com" />
      <div class="kontakt__row">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          E-Mail
          <input type="email" name="email" required />
        </label>
      </div>
      <label>
        Nachricht
        <textarea name="message" rows="4" required></textarea>
      </label>
      <button type="submit" class="button button--light">Kostenloses Erstgespräch vereinbaren</button>
      <p class="kontakt__hint">30 Minuten · kostenlos · ohne Verpflichtung · Antwort innerhalb von 24 Stunden</p>
      <p class="kontakt__status" role="status" aria-live="polite"></p>
    </form>

    <a href="mailto:hello@di-coco.com" class="kontakt__mailto">Oder direkt per E-Mail: hello@di-coco.com</a>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-kontakt-form]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const statusEl = form.querySelector<HTMLParagraphElement>(".kontakt__status");
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!statusEl || !submitBtn) return;

    submitBtn.disabled = true;
    statusEl.textContent = "Wird gesendet …";
    statusEl.classList.remove("kontakt__status--error", "kontakt__status--success");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (response.ok) {
        form.reset();
        statusEl.textContent = "Danke! Deine Nachricht ist angekommen – wir melden uns innerhalb von 24 Stunden.";
        statusEl.classList.add("kontakt__status--success");
      } else {
        throw new Error("submit failed");
      }
    } catch {
      statusEl.textContent = "Da ist leider etwas schiefgelaufen. Schreib uns gern direkt an hello@di-coco.com.";
      statusEl.classList.add("kontakt__status--error");
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .kontakt {
    background: var(--color-orange);
    color: var(--color-white);
    padding: 6.5rem 1.5rem;
  }

  .kontakt__inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .kontakt h2 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin: 0 0 1.25rem;
  }

  .kontakt > .kontakt__inner > p {
    opacity: 0.95;
    margin: 0 0 2.5rem;
  }

  .kontakt__form {
    text-align: left;
    background: rgba(253, 253, 253, 0.08);
    border: 1px solid rgba(253, 253, 253, 0.25);
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kontakt__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .kontakt__form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: var(--font-weight-medium);
    font-size: 0.9rem;
  }

  .kontakt__form input,
  .kontakt__form textarea {
    font-family: inherit;
    padding: 0.75rem 1rem;
    min-height: 44px;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    font-size: 1rem;
    transition: border-color 0.15s ease;
  }

  .kontakt__form input:focus,
  .kontakt__form textarea:focus {
    outline: none;
    border-color: var(--color-black);
  }

  .kontakt__form button {
    align-self: flex-start;
    display: inline-block;
    background: var(--color-white);
    color: var(--color-orange);
    text-decoration: none;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    font-weight: var(--font-weight-semibold);
    border: none;
    cursor: pointer;
    font-size: 1rem;
    font-family: inherit;
    transition: opacity 0.15s ease;
  }

  .kontakt__form button:hover {
    opacity: 0.85;
  }

  .kontakt__hint {
    font-size: 0.85rem;
    opacity: 0.85;
    margin: 0;
  }

  .kontakt__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .kontakt__status {
    font-size: 0.9rem;
    font-weight: var(--font-weight-medium);
    margin: 0;
    min-height: 1.2em;
  }

  .kontakt__status--success {
    color: var(--color-white);
  }

  .kontakt__status--error {
    color: var(--color-black);
  }

  .kontakt__mailto {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--color-white);
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .kontakt__row {
      grid-template-columns: 1fr;
    }
  }
</style>
